<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MuniDigital" parent="Theme.Material3.Light.NoActionBar">
        <!-- Colores primarios -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        
        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryDark</item>
        
        <!-- Colores de fondo -->
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="colorSurface">@color/cardBackground</item>
        
        <!-- Colores de texto -->
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:textColorHint">@color/textHint</item>
        
        <!-- Eliminar el ripple de los botones para consistencia -->
        <item name="android:colorControlHighlight">@color/colorPrimaryLight</item>
    </style>

</resources>